---
import { DialogDemo } from '../../components/DialogDemo';
import FrameworkTabs from '../../components/FrameworkTabs.astro';
import Docs from '../../layouts/Docs.astro';

const install = {
  Package: `pnpm add @cuttle-ui/react @cuttle-ui/styles`,
  CLI: `npx @cuttle-ui/cli add dialog`,
};

const anatomy = `import {
  Dialog,
  DialogClose,
  DialogContent,
  DialogDescription,
  DialogTitle,
  DialogTrigger,
} from '@cuttle-ui/react';

<Dialog>
  <DialogTrigger>Open</DialogTrigger>
  <DialogContent>
    <DialogTitle>Title</DialogTitle>
    <DialogDescription>Description</DialogDescription>
    <DialogClose>Close</DialogClose>
  </DialogContent>
</Dialog>`;

const api = [
  {
    part: 'Dialog',
    props: [
      ['open', 'boolean', '', 'The open state, when you control it'],
      ['defaultOpen', 'boolean', 'false', 'The initial open state, when the dialog controls itself'],
      ['onOpenChange', '(open: boolean) => void', '', 'Called when the state should change'],
    ],
  },
  {
    part: 'DialogTrigger, DialogClose',
    props: [['asChild', 'boolean', 'false', 'Gives the behavior to the only child, such as a Button']],
  },
  {
    part: 'DialogContent',
    props: [
      ['closeOnEscape', 'boolean', 'true', 'Closes when Esc is pressed'],
      ['closeOnOutsidePress', 'boolean', 'true', 'Closes when the area outside is pressed'],
      ['initialFocusRef', 'RefObject<HTMLElement>', '', 'The element to focus on opening. Defaults to the first focusable element'],
    ],
  },
];

const attributes = [
  ['data-cuttle', '"dialog-trigger", "dialog-overlay", "dialog-content", "dialog-title", "dialog-description" or "dialog-close"'],
  ['data-state', '"open" or "closed", on the trigger, overlay and content'],
];
---

<Docs title="Dialog">
  <p>A modal window that needs attention before the rest of the page can be used.</p>

  <h2>Demo</h2>
  <div class="demo"><DialogDemo client:load /></div>

  <h2>Install</h2>
  <FrameworkTabs samples={install} />
  <p>Packages are not published to npm yet, so these commands do not work yet.</p>

  <h2>Anatomy</h2>
  <pre><code>{anatomy}</code></pre>

  <h2>API</h2>
  <p>Each part also accepts the native props of its element, and forwards <code>ref</code>.</p>
  {
    api.map(({ part, props }) => (
      <>
        <h3>{part}</h3>
        <table>
          <thead>
            <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
          </thead>
          <tbody>
            {props.map(([name, type, fallback, description]) => (
              <tr>
                <td><code>{name}</code></td>
                <td><code>{type}</code></td>
                <td><code>{fallback}</code></td>
                <td>{description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ))
  }

  <h2>Styling</h2>
  <table>
    <thead>
      <tr><th>Attribute</th><th>Value</th></tr>
    </thead>
    <tbody>
      {
        attributes.map(([name, value]) => (
          <tr>
            <td><code>{name}</code></td>
            <td>{value}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h2>Keyboard</h2>
  <table>
    <thead>
      <tr><th>Key</th><th>Action</th></tr>
    </thead>
    <tbody>
      <tr><td><kbd>Enter</kbd> or <kbd>Space</kbd></td><td>Opens the dialog from the trigger</td></tr>
      <tr><td><kbd>Tab</kbd></td><td>Moves to the next element, and wraps inside the dialog</td></tr>
      <tr><td><kbd>Shift</kbd> + <kbd>Tab</kbd></td><td>Moves to the previous element, and wraps inside the dialog</td></tr>
      <tr><td><kbd>Esc</kbd></td><td>Closes the dialog and returns focus to the trigger</td></tr>
    </tbody>
  </table>

  <h2>Accessibility</h2>
  <ul>
    <li>Follows the <a href="https://www.w3.org/WAI/ARIA/apg/patterns/dialog-modal/">WAI-ARIA modal dialog pattern</a>.</li>
    <li>Always include a <code>DialogTitle</code>, because it names the dialog for screen readers.</li>
    <li><code>DialogDescription</code> is announced when the dialog opens, so keep it short.</li>
    <li>Page scrolling is locked while the dialog is open. With reduced motion, it opens and closes without animation.</li>
    <li>Dialogs can be nested. <kbd>Esc</kbd> closes only the top one.</li>
  </ul>
</Docs>

<style>
  .demo {
    padding: var(--cuttle-space-5);
    border: 1px solid var(--cuttle-border);
    border-radius: var(--cuttle-radius);
  }
  kbd {
    font-family: var(--cuttle-font-mono);
    font-size: var(--cuttle-text-sm);
  }
</style>
