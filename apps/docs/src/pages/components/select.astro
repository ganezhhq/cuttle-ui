---
import { SelectDemo } from '../../components/Demos';
import ComponentDoc from '../../layouts/ComponentDoc.astro';

const doc = {
  "summary": "Chooses one option from a list, with keyboard navigation and typeahead.",
  "anatomy": "import { Select } from '@cuttle-ui/react';\n\nconst options = [\n  { value: 'apple', label: 'Apple' },\n  { value: 'banana', label: 'Banana', disabled: true },\n];\n\n<Select aria-label=\"Fruit\" options={options} onValueChange={save} />",
  "apiNote": "Accepts native button props for the trigger, and forwards ref to it. Inside a Field, it picks up its label and ARIA connections.",
  "api": [
    {
      "props": [
        [
          "options",
          "SelectOption[]",
          "",
          "Required. Each has a value, a label and optionally disabled"
        ],
        [
          "value",
          "string",
          "",
          "The selected value, when you control it"
        ],
        [
          "defaultValue",
          "string",
          "",
          "The initial value, when the select controls itself"
        ],
        [
          "onValueChange",
          "(value: string) => void",
          "",
          "Called when the selection changes"
        ],
        [
          "placeholder",
          "string",
          "'Select'",
          "Shown while nothing is selected"
        ],
        [
          "name",
          "string",
          "",
          "Adds a hidden input, so the value is sent with a form"
        ],
        [
          "invalid",
          "boolean",
          "false",
          "Marks it as invalid"
        ],
        [
          "disabled",
          "boolean",
          "false",
          "Turns it off"
        ],
        [
          "placement",
          "Placement",
          "'bottom-start'",
          "Where to place the list. It flips when there is no room"
        ]
      ]
    }
  ],
  "attributes": [
    [
      "data-cuttle",
      "\"select-trigger\", \"select-value\", \"select-icon\", \"select-list\" or \"select-option\""
    ],
    [
      "data-state",
      "\"open\" or \"closed\", on the trigger and list"
    ],
    [
      "data-highlighted",
      "Present on the highlighted option"
    ],
    [
      "data-placement",
      "The final side, on the list"
    ],
    [
      "data-placeholder",
      "Present on the value while nothing is selected"
    ],
    [
      "data-invalid",
      "Present on the trigger while invalid"
    ]
  ],
  "a11y": [
    "Focus stays on the trigger while the list is open. The highlighted option is exposed with aria-activedescendant.",
    "Give it a name with a Field or aria-label.",
    "Inside a Dialog, the list stays inside the focus trap, and Esc closes only the list."
  ],
  "keyboard": [
    [
      "Enter, Space, Down or Up",
      "Opens the list. While open, Enter and Space select the highlighted option"
    ],
    [
      "Down, Up",
      "Moves the highlight, skipping disabled options"
    ],
    [
      "Home, End",
      "Moves to the first or last option"
    ],
    [
      "Letters",
      "Moves to the option starting with the typed text"
    ],
    [
      "Esc",
      "Closes without changing the value"
    ],
    [
      "Tab",
      "Selects the highlighted option, closes the list and moves on"
    ]
  ],
  "pattern": {
    "name": "WAI-ARIA select-only combobox pattern",
    "url": "https://www.w3.org/WAI/ARIA/apg/patterns/combobox/examples/combobox-select-only/"
  },
  "slug": "select",
  "title": "Select"
};
---

<ComponentDoc {...doc}>
  <SelectDemo client:load />
</ComponentDoc>
