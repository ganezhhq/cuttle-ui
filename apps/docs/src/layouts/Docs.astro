---
import '@cuttle-ui/styles';

interface Props {
  title: string;
}

const { title } = Astro.props;
const links = [
  ['/', 'Introduction'],
  ['/installation', 'Installation'],
  ['/getting-started', 'Getting started'],
  ['/theming', 'Theming'],
  ['/theme-playground', 'Theme playground'],
  ['/tokens', 'Tokens'],
  ['/components/button', 'Button'],
  ['/components/dialog', 'Dialog'],
  ['/components/input', 'Input'],
  ['/components/textarea', 'Textarea'],
  ['/components/label', 'Label'],
  ['/components/field', 'Field'],
  ['/components/checkbox', 'Checkbox'],
  ['/components/radio-group', 'Radio Group'],
  ['/components/switch', 'Switch'],
  ['/components/select', 'Select'],
  ['/components/tooltip', 'Tooltip'],
  ['/components/popover', 'Popover'],
  ['/components/card', 'Card'],
  ['/components/stack', 'Stack'],
  ['/components/typography', 'Typography'],
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Cuttle UI</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <div class="shell">
      <nav aria-label="Docs">
        <strong>Cuttle UI</strong>
        <ul>
          {
            links.map(([href, label]) => (
              <li>
                <a class="cuttle-focus" href={`${base}${href}`} aria-current={path === href ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <main>
        <h1>{title}</h1>
        <slot />
      </main>
    </div>
    <script>
      // Wide tables scroll inside their own box, rather than making the whole page scroll.
      document.querySelectorAll('main table').forEach((table) => {
        const box = document.createElement('div');
        box.className = 'table-scroll';
        box.setAttribute('role', 'group');
        box.setAttribute('aria-label', 'Table');
        table.replaceWith(box);
        box.append(table);
      });

      // Anything that scrolls sideways has to be reachable by keyboard.
      const updateFocusable = () => {
        document.querySelectorAll<HTMLElement>('main pre, .table-scroll').forEach((block) => {
          if (block.scrollWidth > block.clientWidth) block.tabIndex = 0;
          else if (!block.hasAttribute('aria-label') || block.matches('.table-scroll')) {
            block.removeAttribute('tabindex');
          }
        });
      };
      updateFocusable();
      addEventListener('resize', updateFocusable);
    </script>
  </body>
</html>

<style is:global>
  body {
    background: var(--cuttle-bg);
    color: var(--cuttle-text);
    font-family: var(--cuttle-font-sans);
  }
  .shell {
    display: grid;
    grid-template-columns: 200px minmax(0, 720px);
    gap: var(--cuttle-space-6);
    max-width: 1000px;
    margin-inline: auto;
    padding: var(--cuttle-space-6) var(--cuttle-space-4);
  }
  @media (max-width: 720px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  nav ul {
    list-style: none;
    padding: 0;
    margin-top: var(--cuttle-space-3);
    display: grid;
    gap: var(--cuttle-space-1);
  }
  /* Keeps the page content close to the top on a phone. */
  @media (max-width: 720px) {
    nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--cuttle-space-1) var(--cuttle-space-3);
    }
  }
  nav a {
    color: var(--cuttle-text-muted);
    border-radius: var(--cuttle-radius-sm);
  }
  nav a[aria-current='page'] {
    color: var(--cuttle-accent);
    font-weight: 600;
  }
  main > * + * {
    margin-top: var(--cuttle-space-4);
  }
  framework-tabs {
    display: block;
  }
  main a {
    color: var(--cuttle-accent);
  }
  pre {
    padding: var(--cuttle-space-4);
    overflow-x: auto;
    border: 1px solid var(--cuttle-border);
    border-radius: var(--cuttle-radius);
    background: var(--cuttle-surface);
    font-family: var(--cuttle-font-mono);
    font-size: var(--cuttle-text-sm);
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  .table-scroll {
    overflow-x: auto;
  }
  th,
  td {
    padding: var(--cuttle-space-2);
    border-bottom: 1px solid var(--cuttle-border);
    text-align: start;
  }
</style>
