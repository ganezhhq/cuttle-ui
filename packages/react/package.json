{
  "name": "@cuttle/react",
  "version": "0.0.0",
  "description": "React adapter for Cuttle UI",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": { "@cuttle/core": "workspace:*" },
  "peerDependencies": { "react": ">=19" },
  "devDependencies": {
    "@cuttle/eslint-config": "workspace:*",
    "@cuttle/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": { "access": "public" }
}
